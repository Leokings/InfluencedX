# Server-only database and session configuration
DATABASE_URL=
AUTH_SECRET=
XPROOF_RATE_LIMIT_SECRET=
CRON_SECRET=

# XProof Base Sepolia and GenLayer Bradbury deployments
XPROOF_ATTESTATION_RECEIVER=
XPROOF_GENLAYER_CONTRACT=
XPROOF_CREATOR_REGISTRY=
XPROOF_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Preview-only, one-time operator boundary for the Base Sepolia relay. The
# endpoint also requires VERCEL_ENV=preview and a matching short-lived grant in
# Postgres; it always fails closed in Production.
XPROOF_AUTHORIZATION_BROKER_ENABLED=false

# Server-only ownership evidence keyring. Keep at most four active/retiring keys.
# Generate 32 random bytes per value and encode them as unpadded base64url.
XPROOF_SUBMISSION_ACTIVE_SEAL_KEY_ID=
XPROOF_SUBMISSION_SEAL_KEYS=

# Authenticated, server-to-server submitter boundary. The service validates the
# short-lived Vercel OIDC bearer and exact team/project/environment claims.
XPROOF_SUBMITTER_BRIDGE_ENABLED=false
XPROOF_SUBMITTER_URL=

# Required for production/custom domains. Vercel previews use trusted system URLs.
XPROOF_APP_ORIGIN=
XPROOF_VERIFICATION_MUTATIONS_ENABLED=false
XPROOF_MARKETPLACE_MUTATIONS_ENABLED=false
XPROOF_CAMPAIGN_RELAY_BRIDGE_ENABLED=false
XPROOF_CAMPAIGN_RELAY_URL=https://influencedx-campaign-relay.example.invalid
XPROOF_CAMPAIGN_RELAY_SERVICE_TOKEN=replace-with-a-separate-32-byte-or-longer-secret
