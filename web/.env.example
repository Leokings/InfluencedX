# InfluencedX web: server-only database, session, and abuse controls.
# Generate independent random values. Never expose or commit populated secrets.
DATABASE_URL=
AUTH_SECRET=
XPROOF_RATE_LIMIT_SECRET=
# Protects scheduled cleanup and the explicit maintenance-generation seed route.
CRON_SECRET=

# Active GenLayer Marketplace V2 deployment.
GENLAYER_STUDIONET_RPC_URL=https://studio.genlayer.com/api
INFLUENCEDX_GENLAYER_MARKETPLACE_ADDRESS=0xEaCeBa807a7A4dc370f3B5a8e45539596b8551b4
NEXT_PUBLIC_INFLUENCEDX_GENLAYER_MARKETPLACE_ADDRESS=0xEaCeBa807a7A4dc370f3B5a8e45539596b8551b4
INFLUENCEDX_GENLAYER_MARKETPLACE_VERSION=2

# Required for production/custom domains. Vercel Preview deployments can use
# their trusted system URL. XPROOF_* names are retained compatibility names for
# the active wallet-session/mutation gates; they do not select the old protocol.
XPROOF_APP_ORIGIN=
XPROOF_VERIFICATION_MUTATIONS_ENABLED=false
XPROOF_MARKETPLACE_MUTATIONS_ENABLED=false

# Hosted permissionless maintenance operator. The caller supplies both Vercel
# workload OIDC and an independent 32-byte (64 hex character) service token.
# Enable only after the isolated service, database, exact caller claims, queue,
# and V2 contract pins have been verified.
INFLUENCEDX_MARKETPLACE_OPERATOR_ENABLED=false
INFLUENCEDX_MARKETPLACE_OPERATOR_URL=https://influencedx-marketplace-operator.example.invalid
INFLUENCEDX_OPERATOR_SERVICE_TOKEN=

# Hosted native GEN withdrawal reconciler. It proves the exact finalized child
# transfer and confirms delivery on V2. Only contract status CONFIRMED is shown
# as delivered. Use a different 32-byte service token from the operator.
INFLUENCEDX_WITHDRAWAL_RECONCILER_ENABLED=false
INFLUENCEDX_WITHDRAWAL_RECONCILER_URL=https://influencedx-withdrawal-reconciler.example.invalid
INFLUENCEDX_WITHDRAWAL_RECONCILER_SERVICE_TOKEN=

# Base/USDC, APV2 submitter, watcher, authorization-broker, and campaign-relay
# variables are intentionally absent. They belong to the historical prototype,
# not the active GenLayer-only V2 deployment.
