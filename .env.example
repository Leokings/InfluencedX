BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Recommended: path to the Web3 JSON keystore exported/used by GenLayer CLI.
BASE_SEPOLIA_DEPLOYER_KEYSTORE_PATH=
# Leave both blank for an interactive hidden password prompt. For automation,
# inject one of these as a runtime secret; never commit a password file.
BASE_SEPOLIA_DEPLOYER_KEYSTORE_PASSWORD=
BASE_SEPOLIA_DEPLOYER_KEYSTORE_PASSWORD_FILE=
# Legacy alternative. Do not set this together with any keystore option.
BASE_SEPOLIA_DEPLOYER_PRIVATE_KEY=
# Public one-time recovery input only. Leave blank unless resuming a verified
# successful deployment transaction that predates the deployment journal.
BASE_SEPOLIA_RECOVER_REGISTRY_TRANSACTION_HASH=
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_FINAL_OWNER_ADDRESS=
BASE_SEPOLIA_TREASURY_ADDRESS=
BASE_WATCHER_ADDRESSES=
BASE_WATCHER_THRESHOLD=2
ADPROOF_PROTOCOL_FEE_BPS=250
BASE_CREATOR_REGISTRY_ADDRESS=0x10079EF049D283BC3f212CCaC4291b3aC2719C48
BASE_ESCROW_ADDRESS=0x7e9B6B757d1Ef12509889826B2f2A42906661927
BASE_ATTESTATION_RECEIVER_ADDRESS=0x15dDbCd98F97065746a1c35f88BB670a7A942264
# Recommended relay credential. Keep the encrypted Web3 v3 keystore and its
# password file outside the repository and in separate secret locations. Leave
# the password-file path blank for a hidden interactive prompt.
BASE_RELAYER_KEYSTORE_PATH=
BASE_RELAYER_KEYSTORE_PASSWORD_FILE=
# Disabled compatibility path for disposable Base Sepolia tests only. Both
# values must be set, and neither may be combined with keystore options.
BASE_RELAYER_PRIVATE_KEY=
BASE_RELAYER_ALLOW_TEST_ONLY_RAW_KEY=

GENLAYER_NETWORK=testnet-bradbury
GENLAYER_RPC_URL=
GENLAYER_RESOLVER_ADDRESS=0x017311b35dbB9802883bDaE7Fb0Efd7Bd77cB0b2
GENLAYER_RESOLVER_PRIVATE_KEY=
ADPROOF_WATCHER_KEYSTORE_PATH=
ADPROOF_WATCHER_KEYSTORE_PASSWORD_FILE=

POSTGRES_URL=
X_STRESS_CONCURRENCY=4
X_STRESS_PASSES=2
