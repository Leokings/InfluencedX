# Deploy this same directory as three separate Vercel projects. Each project
# receives exactly one of the three watcher keys and a unique service token.
XPROOF_CAMPAIGN_WATCHER_ENABLED=false
XPROOF_CAMPAIGN_WATCHER_STAGE=testnet
XPROOF_BASE_CHAIN_ID=84532
XPROOF_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
XPROOF_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com
XPROOF_BASE_ESCROW=0x7e9b6b757d1ef12509889826b2f2a42906661927
XPROOF_BASE_RECEIVER=0x15ddbcd98f97065746a1c35f88bb670a7a942264
XPROOF_GENLAYER_RESOLVER=0x017311b35dbB9802883bDaE7Fb0Efd7Bd77cB0b2

# Sensitive; unique to this watcher deployment. Never put multiple keys here.
XPROOF_WATCHER_PRIVATE_KEY=
XPROOF_WATCHER_ADDRESS=
XPROOF_WATCHER_SERVICE_TOKEN=

# Exact relay-coordinator Vercel workload allowed to call this watcher.
XPROOF_CALLER_TEAM_SLUG=
XPROOF_CALLER_TEAM_ID=
XPROOF_CALLER_PROJECT_NAME=
XPROOF_CALLER_PROJECT_ID=
XPROOF_CALLER_ENVIRONMENT=preview
