# Safe fixed StudioNet configuration. Copy to .env.local; never commit values.
XPROOF_SUBMITTER_ENABLED=false
XPROOF_SUBMITTER_STAGE=studionet
XPROOF_GENLAYER_NETWORK=studionet
XPROOF_GENLAYER_CHAIN_ID=61999
XPROOF_GENLAYER_RESOLVER=0x0913b5593Ff16974E2fd616cA678A4986Cb48600
