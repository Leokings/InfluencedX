# Safe fixed testnet configuration. Copy to .env.local; never commit values.
XPROOF_SUBMITTER_ENABLED=false
XPROOF_SUBMITTER_STAGE=testnet
XPROOF_GENLAYER_NETWORK=testnet-bradbury
XPROOF_GENLAYER_RESOLVER=0x017311b35dbB9802883bDaE7Fb0Efd7Bd77cB0b2

# Secrets; this key belongs only to the separate submitter project.
GENLAYER_SUBMITTER_PRIVATE_KEY=
DATABASE_URL=

# Exact Vercel workload identity allowed to call public ingress.
XPROOF_CALLER_TEAM_SLUG=
XPROOF_CALLER_TEAM_ID=
XPROOF_CALLER_PROJECT_NAME=influencedx
XPROOF_CALLER_PROJECT_ID=
XPROOF_CALLER_ENVIRONMENT=preview
