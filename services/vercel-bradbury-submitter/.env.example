# Exact Vercel workload identity allowed to call public ingress.
XPROOF_CALLER_TEAM_SLUG=
XPROOF_CALLER_TEAM_ID=
XPROOF_CALLER_PROJECT_NAME=influencedx
XPROOF_CALLER_PROJECT_ID=
