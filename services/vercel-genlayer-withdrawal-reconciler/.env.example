# Disabled unless this is changed to exactly true in an intentional deployment.
INFLUENCEDX_WITHDRAWAL_RECONCILER_ENABLED=false
INFLUENCEDX_WITHDRAWAL_RECONCILER_STAGE=studionet
INFLUENCEDX_GENLAYER_NETWORK=studionet
INFLUENCEDX_GENLAYER_CHAIN_ID=61999
INFLUENCEDX_GENLAYER_RPC_URL=https://studio.genlayer.com/api
# Audited deployment tx: 0x05ff78998a2b389c7e102f6f09b893dbd16d376f3c18f9748b2b8ef9de5e7998
INFLUENCEDX_GENLAYER_MARKETPLACE_ADDRESS=0xb72fe7272a5aedf3c6ba893394ebef818fd86fbb
INFLUENCEDX_GENLAYER_MARKETPLACE_WITHDRAWAL_CONFIRMER=0xaafc5d9075a404d82b8ee1692f7ff802168c5dd8
INFLUENCEDX_GENLAYER_MARKETPLACE_PROTOCOL=INFLUENCEDX_MARKETPLACE_V2
INFLUENCEDX_GENLAYER_MARKETPLACE_SCHEMA_VERSION=2

# Dedicated withdrawal confirmer signer for confirm_withdrawal only. It must
# not be the owner, pending owner, or upgrade admin and must not be reused in
# the marketplace maintenance operator or exposed to the web project.
GENLAYER_WITHDRAWAL_CONFIRMER_PRIVATE_KEY=
DATABASE_URL=

# Exact Vercel workload permitted to enqueue and read reconciliation status.
INFLUENCEDX_WITHDRAWAL_CALLER_TEAM_SLUG=
INFLUENCEDX_WITHDRAWAL_CALLER_TEAM_ID=
INFLUENCEDX_WITHDRAWAL_CALLER_PROJECT_NAME=
INFLUENCEDX_WITHDRAWAL_CALLER_PROJECT_ID=
INFLUENCEDX_WITHDRAWAL_CALLER_ENVIRONMENT=preview

# Independent random 32-byte hex secret sent in
# x-influencedx-withdrawal-service-token. Never expose it to browser code.
INFLUENCEDX_WITHDRAWAL_RECONCILER_SERVICE_TOKEN=
